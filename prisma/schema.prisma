generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL") // t
}

model Subscriber {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(120)
  email     String   @unique @db.VarChar(190)
  phone     String?  @db.VarChar(32)
  industry  String   @db.VarChar(80)
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([industry])
  @@map("subscribers")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  EXHIBITING
  DECLINED
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
}

model Lead {
  id          Int             @id @default(autoincrement())
  companyName String          @map("company_name") @db.VarChar(160)
  contactName String?         @map("contact_name") @db.VarChar(120)
  // Nullable: a lead can now arrive "company-first" via the API-key
  // import endpoint, before any individual contact/email is known.
  // Still unique when present (MySQL allows multiple NULLs in a
  // unique index, so this doesn't block company-only records).
  email       String?         @unique @db.VarChar(190)
  phone       String?         @db.VarChar(32)
  // Unique + nullable: the primary de-dupe key for company-only imports.
  website     String?         @unique @db.VarChar(300)
  industry    String?         @db.VarChar(80)
  status      LeadStatus      @default(NEW)
  notes       String?         @db.Text

  // Lead-management / CRM workflow fields
  leadSource     String?      @map("lead_source") @db.VarChar(120)
  leadOwner      String?      @map("lead_owner") @db.VarChar(120)
  leadScore      Int          @default(0) @map("lead_score")
  priority       LeadPriority @default(MEDIUM)
  lastContactedAt DateTime?   @map("last_contacted_at")
  nextFollowUpAt  DateTime?   @map("next_follow_up_at")

  // Everything from the standard lead JSON that doesn't need its own
  // column (company profile, location, digital presence, target market,
  // products/services, key people, marketing opportunity, data quality).
  // Kept queryable-enough via JSON while staying scalable without a
  // migration every time a new sub-field shows up.
  profile Json? @map("profile")

  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  socials     SocialProfile[]
  contacts    LeadContact[]

  @@index([status])
  @@index([createdAt])
  @@index([priority])
  @@index([leadScore])
  @@map("leads")
}

model SocialProfile {
  id       Int    @id @default(autoincrement())
  leadId   Int    @map("lead_id")
  lead     Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  platform String @db.VarChar(40)
  url      String @db.VarChar(300)

  @@index([leadId])
  @@map("lead_social_profiles")
}

/// "Core members" / decision-makers at a lead's company — the "contacts"
/// side of the standard lead JSON format, imported via the dedicated
/// contacts API-key endpoint (kept separate from company-level data so
/// each can be enriched/re-synced independently).
model LeadContact {
  id       Int  @id @default(autoincrement())
  leadId   Int  @map("lead_id")
  lead     Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  name           String? @db.VarChar(160)
  firstName      String? @map("first_name") @db.VarChar(80)
  lastName       String? @map("last_name") @db.VarChar(80)
  jobTitle       String? @map("job_title") @db.VarChar(160)
  department     String? @db.VarChar(120)
  seniorityLevel String? @map("seniority_level") @db.VarChar(60)
  roleCategory   String? @map("role_category") @db.VarChar(60)
  decisionMaker  Boolean @default(false) @map("decision_maker")

  workEmail   String? @unique @map("work_email") @db.VarChar(190)
  mobilePhone String? @map("mobile_phone") @db.VarChar(32)
  officePhone String? @map("office_phone") @db.VarChar(32)

  linkedin String? @db.VarChar(300)
  twitter  String? @db.VarChar(300)
  facebook String? @db.VarChar(300)

  city    String? @db.VarChar(120)
  state   String? @db.VarChar(120)
  country String? @db.VarChar(120)

  sourceUrl       String?  @map("source_url") @db.VarChar(300)
  verified        Boolean  @default(false)
  confidenceScore Int?     @map("confidence_score")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([leadId])
  @@index([decisionMaker])
  @@map("lead_contacts")
}
